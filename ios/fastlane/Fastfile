# frozen_string_literal: true

require "shellwords"

default_platform(:ios)

platform :ios do
  desc "Run SecureVaultKit Swift Package tests"
  lane :test_package do
    package_path = File.expand_path("../../packages/SecureVaultKit", __dir__)
    clang_cache = File.join(package_path, ".build", "module-cache")
    swift_cache = File.join(package_path, ".build", "swift-module-cache")
    sh(
      "cd #{Shellwords.escape(package_path)} && " \
      "CLANG_MODULE_CACHE_PATH=#{Shellwords.escape(clang_cache)} " \
      "SWIFT_MODULE_CACHE_PATH=#{Shellwords.escape(swift_cache)} " \
      "swift test --disable-sandbox"
    )
  end

  desc "Run iOS unit tests"
  lane :test_ios do
    project_path = File.expand_path("../AegisVault/AegisVault.xcodeproj", __dir__)
    derived_data = File.expand_path("../AegisVault/.build/TestDerivedData", __dir__)
    destination = Shellwords.escape("platform=iOS Simulator,name=iPhone 17 Pro,OS=latest")
    sh(
      "xcodebuild -project #{Shellwords.escape(project_path)} " \
      "-scheme AegisVault -configuration Debug " \
      "-destination #{destination} " \
      "-derivedDataPath #{Shellwords.escape(derived_data)} test"
    )
  end

  desc "Build iOS app for verification"
  lane :build do
    project_path = File.expand_path("../AegisVault/AegisVault.xcodeproj", __dir__)
    derived_data = File.expand_path("../AegisVault/.build/DerivedData", __dir__)
    destination = Shellwords.escape("generic/platform=iOS Simulator")
    sh(
      "xcodebuild -project #{Shellwords.escape(project_path)} " \
      "-scheme AegisVault -configuration Debug -sdk iphonesimulator " \
      "-destination #{destination} " \
      "-derivedDataPath #{Shellwords.escape(derived_data)} " \
      "CODE_SIGNING_ALLOWED=NO build"
    )
  end

  desc "Run local quality checks"
  lane :quality do
    test_package
    # Add SwiftLint later once project config is finalized.
    # sh("swiftlint")
  end

  desc "Prepare TestFlight build"
  lane :beta do
    UI.user_error!("Beta lane is inactive until signing and App Store Connect are configured.")
  end
end
