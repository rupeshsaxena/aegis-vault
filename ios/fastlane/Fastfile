# frozen_string_literal: true

require "shellwords"

default_platform(:ios)

platform :ios do
  desc "Run SecureVaultKit Swift Package tests"
  lane :test_package do
    package_path = File.expand_path("../../packages/SecureVaultKit", __dir__)
    clang_cache = File.join(package_path, ".build", "module-cache")
    swift_cache = File.join(package_path, ".build", "swift-module-cache")
    sh(
      "cd #{Shellwords.escape(package_path)} && " \
      "CLANG_MODULE_CACHE_PATH=#{Shellwords.escape(clang_cache)} " \
      "SWIFT_MODULE_CACHE_PATH=#{Shellwords.escape(swift_cache)} " \
      "swift test --disable-sandbox"
    )
  end

  desc "Run iOS unit tests"
  lane :test_ios do
    UI.user_error!("iOS app target is not created yet.")
  end

  desc "Build iOS app for verification"
  lane :build do
    UI.user_error!("iOS app target is not created yet.")
  end

  desc "Run local quality checks"
  lane :quality do
    test_package
    # Add SwiftLint later once project config is finalized.
    # sh("swiftlint")
  end

  desc "Prepare TestFlight build"
  lane :beta do
    UI.user_error!("Beta lane is inactive until signing and App Store Connect are configured.")
  end
end
