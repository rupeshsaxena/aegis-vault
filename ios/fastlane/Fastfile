# frozen_string_literal: true

default_platform(:ios)

platform :ios do
  desc "Run SecureVaultKit Swift Package tests"
  lane :test_package do
    sh("cd ../packages/SecureVaultKit && swift test")
  end

  desc "Run iOS unit tests"
  lane :test_ios do
    scan(
      scheme: "AegisVault",
      clean: true,
      device: "iPhone 15",
      output_directory: "fastlane/test_output"
    )
  end

  desc "Build iOS app for verification"
  lane :build do
    gym(
      scheme: "AegisVault",
      clean: true,
      export_method: "development",
      output_directory: "fastlane/build"
    )
  end

  desc "Run local quality checks"
  lane :quality do
    test_package
    # Add SwiftLint later once project config is finalized.
    # sh("swiftlint")
  end

  desc "Prepare TestFlight build"
  lane :beta do
    increment_build_number(
      build_number: Time.now.strftime("%Y%m%d%H%M")
    )

    gym(
      scheme: "AegisVault",
      clean: true,
      export_method: "app-store",
      output_directory: "fastlane/build"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end
